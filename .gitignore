# Database is a build artifact (REBUILD_DESIGN.md §2)
*.db
*.db-journal
*.db-wal
*.db-shm
# Raw fetches: immutable, local, never committed
data/raw/
# Secrets — `*.env` only matches names ENDING in .env; `.env.*` covers backups like .env.bak_<ts>
.env
.env.*
*.env
# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/
# Runtime status
PIPELINE_STATUS.json
# Ops logs (ops/*.bat)
data/logs/
